{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "small",
      "source": "apple",
      "padding": {
        "top": 2,
        "left": 2,
        "right": 4
    }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	      {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " "
        },
        {
            "type": "kernel",
            "key": " "
        },
        {
            "type": "packages",
            "key": " ",
            "combined": false
        },
        {
            "type": "shell",
            "key": " "
        },
        {
            "type": "terminal",
            "key": " "
        },
        {
            "type": "wm",
            "key": " "
        },
        {
            "type": "uptime",
            "key": " "
        },
        "break",
        "colors",
        "break"
    ]
}
