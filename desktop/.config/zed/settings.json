// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "languages": {
    "Java": {
      "preferred_line_length": 150
    }
  },
  "cli_default_open_behavior": "existing_window",
  "theme": "Caelestia",
  "icon_theme": "Base Charmed Icons",
  "buffer_font_size": 14.0,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "sort_by_path": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "minimap": {
    "show": "always",
  },
  "status_bar": {
    "show_active_file": true,
  },
}
